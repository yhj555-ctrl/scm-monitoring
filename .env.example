# 로그인 계정 (미설정 시 아래 기본값 사용: procurement / rnaoxla2026!)
AUTH_USERNAME=procurement
AUTH_PASSWORD=rnaoxla2026!

# 세션 쿠키 서명용 비밀키 — 운영(Vercel)에서는 반드시 임의의 긴 문자열로 설정하세요.
# 예: openssl rand -hex 32
AUTH_SECRET=

# 전자공시시스템(DART) OpenAPI 키 — 무료 발급: https://opendart.fss.or.kr/
# 설정 시 /suppliers 의 "공시정보" 열과 업체 상세 팝업에 최근 DART 공시가 표시됩니다.
# 미설정 시 해당 열은 "미설정"으로 표시되고 나머지 기능은 정상 동작합니다.
DART_API_KEY=
